# Copier en .env et renseigner. NE JAMAIS committer le .env réel.

# Serveur
PORT=4000

# Base de données PostgreSQL
DATABASE_URL=postgres://ulysse:ulysse@localhost:5432/ulysse70

# Auth
JWT_SECRET=change-me-en-production-secret-long-et-aleatoire
JWT_EXPIRES_IN=12h

# Lecture croquis (modèle de vision Anthropic) — CÔTÉ BACKEND UNIQUEMENT.
# Sans cette clé, l'endpoint /api/vision/lire renvoie 503 et le vendeur saisit à la main.
ANTHROPIC_API_KEY=
VISION_MODEL=claude-opus-4-8

# CORS : origine(s) du frontend autorisée(s), séparées par des virgules
CORS_ORIGIN=http://localhost:5173
