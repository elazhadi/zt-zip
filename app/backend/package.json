{
  "name": "@ulysse70/backend",
  "version": "1.0.0",
  "private": true,
  "description": "API ULYSSE 70 — auth, sites, chantiers, débitage, lecture croquis (vision).",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node -e \"require('./src/db/migrate').migrate(require('./src/db/pool').pool).then(()=>process.exit(0))\"",
    "seed": "node -e \"require('./src/db/seed').seed(require('./src/db/pool').pool).then(()=>process.exit(0))\"",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@ulysse70/moteur": "*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "pg-mem": "^3.0.5",
    "supertest": "^7.0.0"
  }
}
